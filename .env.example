# ─────────────────────────────────────────────────────────────
# OmniAI environment configuration
# Copy to .env (`npm run setup` does this and generates secrets).
# Never commit real credentials. Nothing here is exposed to the browser
# unless it is prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Database (docker compose maps postgres to host port 5433 by default)
DATABASE_URL=postgresql://omniai:omniai@localhost:5433/omniai?schema=public
# Used by `npm run test:integration`
TEST_DATABASE_URL=postgresql://omniai:omniai@localhost:5433/omniai_test?schema=public

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Allow public self-service sign-up (set false for invite-only installs)
ALLOW_REGISTRATION=true

# Encryption key for secrets stored in the database (32 bytes, base64)
# generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# OpenAI
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (default: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Speech-to-text for WhatsApp voice messages
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Override only for tests or an egress proxy
WHATSAPP_GRAPH_URL=https://graph.facebook.com

# HubSpot API base URL (override only for tests)
HUBSPOT_API_URL=https://api.hubapi.com

# Redis (rate limiting, queues, realtime fan-out)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=omniai
S3_SECRET_KEY=omniai-secret
S3_BUCKET=omniai-uploads
S3_FORCE_PATH_STYLE=true

# Observability (optional)
SENTRY_DSN=
